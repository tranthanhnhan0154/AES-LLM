# Ollama Modelfile cho mô hình IELTS Essay Scorer Llama-3.1-8B (1-LoRA)

# Chỉ định đường dẫn tới tệp GGUF
FROM ./merged_model_4bit_from_16bit_gguf/Meta-Llama-3.1-8B.BF16.gguf

# Thiết lập ngữ cảnh và giới hạn sinh từ
PARAMETER num_ctx 4096
PARAMETER num_predict 1024

# Thiết lập các tham số sinh từ (Inference Parameters)
PARAMETER temperature 0.1
PARAMETER top_p 0.9
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
PARAMETER stop "<|image|>"

# Tùy chỉnh template prompt cho Llama 3.1
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|><|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""
